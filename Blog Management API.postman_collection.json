                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blogTitle\": \"Introduction to API Testing\",\n  \"blog\": \"This article explains the fundamentals of API testing...\",\n  \"category\": \"Testing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
