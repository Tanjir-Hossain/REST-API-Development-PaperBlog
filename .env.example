# Copy this file to ".env" and fill in your own values.

# HTTP server
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=blogdb

# JSON Web Token
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Environment ("development" exposes the password-reset token in the API
# response so the reset flow can be tested without an email provider).
NODE_ENV=development

# Where the frontend runs — used to build the password-reset link.
FRONTEND_URL=http://localhost:3000
